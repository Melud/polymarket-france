---
interface Outcome {
  name: string;
  price: number;
}
interface HistoryPoint {
  ts: string;
  volume: number;
  outcomes: Outcome[];
}
interface Market {
  title_fr: string;
  description_fr: string;
  url: string;
  category?: string;
  source?: string;
  history: HistoryPoint[];
}

import { candidateColor, candidateInitials, isDateLabel } from "../lib/candidateColors";
import { ema } from "../lib/smoothing";
import { sourceLabel } from "../lib/sources";

// lissage exponentiel appliqué uniquement à la courbe du graphique — les
// barres/pourcentages affichés restent le prix brut du dernier relevé
const SMOOTHING_ALPHA = 0.5;

const { slug, market } = Astro.props as { slug: string; market: Market };

const latest = market.history[market.history.length - 1];
// certains marchés ("Lecornu quittera-t-il Matignon ?"...) ont des outcomes
// qui sont des échéances plutôt que des candidats — une échéance déjà
// résolue (prix quasi nul) n'a plus d'intérêt une fois la date passée, on
// la masque. Un candidat à 0 % reste affiché : ce n'est pas la même chose.
const outcomes = (latest?.outcomes ?? []).filter((o) => !(isDateLabel(o.name) && o.price < 0.005));

const VISIBLE_COUNT = 6;
const visibleOutcomes = outcomes.slice(0, VISIBLE_COUNT);
const extraOutcomes = outcomes.slice(VISIBLE_COUNT);

// on garde jusqu'à 6 courbes (les plus hautes en prix final) pour ne pas surcharger le graphique
const topNames = outcomes.slice(0, 6).map((o) => o.name);

const chartData = {
  labels: market.history.map((h) => h.ts),
  series: topNames.map((name) => ({
    name,
    color: candidateColor(name, slug),
    initials: candidateInitials(name),
    data: ema(
      market.history.map((h) => {
        const found = h.outcomes.find((o) => o.name === name);
        return found ? found.price * 100 : null;
      }),
      SMOOTHING_ALPHA
    ).map((v) => (v == null ? null : Math.round(v))), // en %
  })),
};
---

<article class="card" id={`card-${slug}`} data-category={market.category ?? "Autres"}>
  <header>
    <div class="header-row">
      <h2>{market.title_fr}</h2>
      <button class="copy-link-btn" type="button" data-slug={slug} title="Copier le lien direct de ce marché" aria-label="Copier le lien direct de ce marché">🔗</button>
    </div>
    <div class="subtitle-row">
      <p class="desc">{market.description_fr}</p>
      <span class={`source-badge ${market.source ?? "polymarket"}`}>{sourceLabel(market.source)}</span>
    </div>
  </header>

  <ul class="bars">
    {visibleOutcomes.map((o) => (
      <li>
        <div class="bar-row">
          <span class="label">{o.name}</span>
          <span class="pct">{Math.round(o.price * 100)}%</span>
        </div>
        <div class="bar-track">
          <div class="bar-fill" style={`width:${o.price * 100}%; background:${candidateColor(o.name, slug)}`}></div>
        </div>
      </li>
    ))}
  </ul>

  {extraOutcomes.length > 0 && (
    <>
      <ul class="bars extra" hidden>
        {extraOutcomes.map((o) => (
          <li>
            <div class="bar-row">
              <span class="label">{o.name}</span>
              <span class="pct">{Math.round(o.price * 100)}%</span>
            </div>
            <div class="bar-track">
              <div class="bar-fill" style={`width:${o.price * 100}%; background:${candidateColor(o.name, slug)}`}></div>
            </div>
          </li>
        ))}
      </ul>
      <button class="toggle-btn" type="button">Voir {extraOutcomes.length} de plus ↓</button>
    </>
  )}

  {market.history.length > 1 && (
    <div class="chart-wrap">
      <canvas class="chart" data-chart={JSON.stringify(chartData)}></canvas>
    </div>
  )}

  <footer>
    <a href={market.url} target="_blank" rel="noopener">Voir sur {sourceLabel(market.source)} ↗</a>
    <span class="updated">Maj : {latest ? new Date(latest.ts).toLocaleString("fr-FR", { timeZone: "Europe/Paris" }) : "—"}</span>
  </footer>
</article>

<script>
  document.querySelectorAll(".toggle-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const extra = btn.previousElementSibling as HTMLElement | null;
      if (!extra) return;
      const isHidden = extra.hasAttribute("hidden");
      if (isHidden) {
        extra.removeAttribute("hidden");
        btn.textContent = btn.textContent!.replace("de plus ↓", "de moins ↑");
      } else {
        extra.setAttribute("hidden", "");
        btn.textContent = btn.textContent!.replace("de moins ↑", "de plus ↓");
      }
    });
  });
</script>

<style>
  .card {
    border: 1px solid #e3e2de;
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
    background: #ffffff;
    box-shadow: 0 1px 3px rgba(20, 20, 20, 0.05);
  }
  h2 { margin: 0; font-size: 1.15rem; }
  .desc { margin: 0; color: #6b6a66; font-size: 0.9rem; }
  .header-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.6rem; }
  .subtitle-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.6rem; margin: 0.35rem 0 1rem; }
  .source-badge {
    flex: none;
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .source-badge.polymarket { background: #e8edfb; color: #2454c7; }
  .source-badge.kalshi { background: #e3f5ef; color: #0f7a5f; }
  .copy-link-btn {
    flex: none;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 0.95rem;
    line-height: 1;
    padding: 0.15rem 0.3rem;
    border-radius: 6px;
    color: #8a8983;
  }
  .copy-link-btn:hover { background: #ece9e3; }
  .bars { list-style: none; margin: 0; padding: 0; }
  .bars li { margin-bottom: 0.5rem; }
  .bar-row { display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 2px; }
  .bar-track { background: #ece9e3; border-radius: 6px; height: 8px; overflow: hidden; }
  .bar-fill { background: #4f8cff; height: 100%; }
  .toggle-btn {
    display: block;
    margin: 0.5rem 0 0;
    padding: 0.4rem 0.75rem;
    background: transparent;
    border: 1px solid #ddd;
    border-radius: 8px;
    color: #6b6a66;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .toggle-btn:hover { border-color: #2454c7; color: #1a1a1a; }
  .chart-wrap { margin-top: 1.25rem; height: 320px; }
  footer { display: flex; justify-content: space-between; margin-top: 1rem; font-size: 0.8rem; color: #8a8983; }
  footer a { color: #2454c7; text-decoration: none; }
</style>
