---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../components/BaseLayout.astro";
import ChartScripts from "../components/ChartScripts.astro";
import MarketCard from "../components/MarketCard.astro";
import BinaryMarketCard from "../components/BinaryMarketCard.astro";

const dataPath = path.resolve(process.cwd(), "../data/markets.json");
const raw = fs.existsSync(dataPath) ? fs.readFileSync(dataPath, "utf-8") : "{}";
const markets: Record<string, any> = JSON.parse(raw);

const entries = Object.entries(markets);

// ordre préféré pour les onglets ; toute catégorie présente mais absente de
// cette liste (ex. un futur "Autres") est ajoutée à la fin par ordre d'apparition
const PREFERRED_ORDER = ["Présidentielle", "Partis", "Budget"];
const seen = new Set(entries.map(([, m]) => m.category ?? "Autres"));
const categories = [
  ...PREFERRED_ORDER.filter((c) => seen.has(c)),
  ...[...seen].filter((c) => !PREFERRED_ORDER.includes(c)),
];

// aperçu de lien (WhatsApp, etc.) : on met en avant le premier marché de la
// liste et son candidat en tête, recalculé à chaque build donc toujours à jour
const SITE_URL = "https://polymarket-france.vercel.app/";
const firstMarket = entries[0]?.[1];
const ogTitle = "Polymarket France";
const ogDescription = (() => {
  const latest = firstMarket?.history?.[firstMarket.history.length - 1];
  const top = latest?.outcomes?.[0];
  if (firstMarket && top) {
    return `${firstMarket.description_fr} — ${top.name} en tête avec ${Math.round(top.price * 100)}%`;
  }
  return "Suivi non officiel des marchés prédictifs concernant la France (Polymarket, Kalshi), traduits en français.";
})();
---

<BaseLayout
  title="Polymarket France — marchés prédictifs traduits"
  description={ogDescription}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  url={SITE_URL}
>
  <h1>Polymarket — marchés concernant la France</h1>
  <p class="intro">
    Suivi non officiel des marchés prédictifs concernant la France (Polymarket, Kalshi), traduits en
    français. Site indépendant, non affilié à ces plateformes, à but purement informatif — aucune
    fonction de pari.
  </p>

  {entries.length === 0 && <p>Aucune donnée pour l'instant — lancez le script de collecte.</p>}

  {categories.length > 1 && (
    <div class="pillbar" role="tablist" aria-label="Filtrer par catégorie">
      <button class="pill active" data-category="all" type="button">Tous</button>
      {categories.map((cat) => (
        <button class="pill" data-category={cat} type="button">{cat}</button>
      ))}
    </div>
  )}

  {entries.map(([slug, market]) => (
    market.style === "binary"
      ? <BinaryMarketCard slug={slug} market={market} />
      : <MarketCard slug={slug} market={market} />
  ))}

  <ChartScripts />

  <script>
    document.querySelectorAll(".pillbar .pill").forEach((pill) => {
      pill.addEventListener("click", () => {
        document.querySelectorAll(".pillbar .pill").forEach((p) => p.classList.remove("active"));
        pill.classList.add("active");
        const cat = pill.dataset.category;
        document.querySelectorAll(".card").forEach((card) => {
          card.hidden = cat !== "all" && card.dataset.category !== cat;
        });
      });
    });
  </script>
</BaseLayout>
