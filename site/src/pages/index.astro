---
import fs from "node:fs";
import path from "node:path";
import MarketCard from "../components/MarketCard.astro";
import BinaryMarketCard from "../components/BinaryMarketCard.astro";

const dataPath = path.resolve(process.cwd(), "../data/markets.json");
const raw = fs.existsSync(dataPath) ? fs.readFileSync(dataPath, "utf-8") : "{}";
const markets: Record<string, any> = JSON.parse(raw);

const entries = Object.entries(markets);

// ordre préféré pour les onglets ; toute catégorie présente mais absente de
// cette liste (ex. un futur "Autres") est ajoutée à la fin par ordre d'apparition
const PREFERRED_ORDER = ["Présidentielle", "Partis", "Budget"];
const seen = new Set(entries.map(([, m]) => m.category ?? "Autres"));
const categories = [
  ...PREFERRED_ORDER.filter((c) => seen.has(c)),
  ...[...seen].filter((c) => !PREFERRED_ORDER.includes(c)),
];

// aperçu de lien (WhatsApp, etc.) : on met en avant le premier marché de la
// liste et son candidat en tête, recalculé à chaque build donc toujours à jour
const SITE_URL = "https://polymarket-france.vercel.app/";
const firstMarket = entries[0]?.[1];
const ogTitle = "Polymarket France";
const ogDescription = (() => {
  const latest = firstMarket?.history?.[firstMarket.history.length - 1];
  const top = latest?.outcomes?.[0];
  if (firstMarket && top) {
    return `${firstMarket.description_fr} — ${top.name} en tête avec ${Math.round(top.price * 100)}%`;
  }
  return "Suivi non officiel des marchés prédictifs Polymarket concernant la France, traduits en français.";
})();
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Polymarket France — marchés prédictifs traduits</title>
    <meta name="description" content={ogDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Polymarket France" />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
  </head>
  <body>
    <main>
      <h1>Polymarket — marchés concernant la France</h1>
      <p class="intro">
        Suivi non officiel des marchés prédictifs Polymarket concernant la France, traduits en français.
        Site indépendant, non affilié à Polymarket, à but purement informatif — aucune fonction de pari.
      </p>

      {entries.length === 0 && <p>Aucune donnée pour l'instant — lancez le script de collecte.</p>}

      {categories.length > 1 && (
        <div class="pillbar" role="tablist" aria-label="Filtrer par catégorie">
          <button class="pill active" data-category="all" type="button">Tous</button>
          {categories.map((cat) => (
            <button class="pill" data-category={cat} type="button">{cat}</button>
          ))}
        </div>
      )}

      {entries.map(([slug, market]) => (
        market.style === "binary"
          ? <BinaryMarketCard slug={slug} market={market} />
          : <MarketCard slug={slug} market={market} />
      ))}
    </main>

    <script>
      const crosshairPlugin = {
        id: "crosshair",
        afterDatasetsDraw(chart) {
          const active = chart.tooltip?.getActiveElements?.() ?? [];
          if (active.length === 0) return;
          const { x } = active[0].element;
          const { top, bottom } = chart.chartArea;
          const ctx = chart.ctx;
          ctx.save();
          ctx.beginPath();
          ctx.moveTo(x, top);
          ctx.lineTo(x, bottom);
          ctx.lineWidth = 1;
          ctx.strokeStyle = "rgba(20,20,20,0.25)";
          ctx.setLineDash([4, 4]);
          ctx.stroke();
          ctx.restore();
        },
      };
      Chart.register(crosshairPlugin);

      const endLabelsPlugin = {
        id: "endLabels",
        afterDatasetsDraw(chart) {
          const { ctx, chartArea, data } = chart;
          const items = [];
          data.datasets.forEach((ds, i) => {
            if (!chart.isDatasetVisible(i)) return;
            let idx = ds.data.length - 1;
            while (idx >= 0 && ds.data[idx] == null) idx--;
            if (idx < 0) return;
            const point = chart.getDatasetMeta(i).data[idx];
            if (!point) return;
            items.push({ label: ds.initials ?? ds.label, color: ds.borderColor, y: point.y });
          });

          // évite que deux étiquettes se chevauchent quand deux courbes finissent au même niveau
          items.sort((a, b) => a.y - b.y);
          const minGap = 15;
          for (let k = 1; k < items.length; k++) {
            if (items[k].y - items[k - 1].y < minGap) items[k].y = items[k - 1].y + minGap;
          }

          ctx.save();
          ctx.font = "bold 13px system-ui, sans-serif";
          ctx.textBaseline = "middle";
          items.forEach((it) => {
            ctx.fillStyle = it.color;
            ctx.fillText(it.label, chartArea.right + 6, it.y);
          });
          ctx.restore();
        },
      };
      Chart.register(endLabelsPlugin);

      function renderCharts() {
        document.querySelectorAll("canvas.chart").forEach((canvas) => {
          const raw = canvas.getAttribute("data-chart");
          if (!raw) return;
          const { labels, series } = JSON.parse(raw);
          const fallbackColors = ["#4f8cff", "#ff6b6b", "#51cf66", "#ffd43b", "#cc5de8", "#ff922b"];

          const maxValue = Math.max(
            0,
            ...series.flatMap((s) => s.data.filter((v) => v != null))
          );
          // plafond arrondi à la dizaine au-dessus du max réel, entre 10 et 100,
          // pour n'avoir que des tranches de 10 %
          const yMax = Math.min(100, Math.max(10, Math.ceil((maxValue + 2) / 10) * 10));

          new Chart(canvas, {
            type: "line",
            data: {
              labels: labels.map((l) => new Date(l).toLocaleDateString("fr-FR", { day: "2-digit", month: "2-digit", year: "2-digit", timeZone: "Europe/Paris" })),
              datasets: series.map((s, i) => {
                const color = s.color ?? fallbackColors[i % fallbackColors.length];
                return {
                  label: s.name,
                  initials: s.initials,
                  data: s.data,
                  borderColor: color,
                  backgroundColor: "transparent",
                  tension: 0.2,
                  pointRadius: 0,
                  pointHoverRadius: 4,
                  pointBackgroundColor: color,
                  pointBorderColor: color,
                  pointBorderWidth: 0,
                  pointHoverBackgroundColor: color,
                  pointHoverBorderColor: color,
                  pointHoverBorderWidth: 0,
                };
              }),
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              layout: { padding: { right: 36 } },
              interaction: { mode: "index", intersect: false },
              scales: {
                x: { ticks: { autoSkip: true, maxTicksLimit: 10 } },
                y: { min: 0, max: yMax, ticks: { stepSize: 10, callback: (v) => v + "%" } },
              },
              plugins: {
                legend: {
                  labels: {
                    font: { size: 11 },
                    usePointStyle: true,
                    pointStyleWidth: 20,
                    generateLabels: (chart) =>
                      chart.data.datasets.map((ds, i) => ({
                        text: ds.initials ? `${ds.label} (${ds.initials})` : ds.label,
                        fillStyle: ds.borderColor,
                        strokeStyle: ds.borderColor,
                        lineWidth: 3,
                        pointStyle: "line",
                        hidden: !chart.isDatasetVisible(i),
                        datasetIndex: i,
                      })),
                  },
                },
                tooltip: {
                  mode: "index",
                  intersect: false,
                  usePointStyle: true,
                  itemSort: (a, b) => (b.raw ?? 0) - (a.raw ?? 0),
                  backgroundColor: "#ffffff",
                  borderColor: "#ddd",
                  borderWidth: 1,
                  titleColor: "#1a1a1a",
                  bodyColor: "#444",
                  padding: 10,
                  callbacks: {
                    label: (context) =>
                      `${context.dataset.label} : ${context.formattedValue}%`,
                  },
                },
              },
            },
          });
        });
      }
      renderCharts();

      document.querySelectorAll(".pillbar .pill").forEach((pill) => {
        pill.addEventListener("click", () => {
          document.querySelectorAll(".pillbar .pill").forEach((p) => p.classList.remove("active"));
          pill.classList.add("active");
          const cat = pill.dataset.category;
          document.querySelectorAll(".card").forEach((card) => {
            card.hidden = cat !== "all" && card.dataset.category !== cat;
          });
        });
      });

      document.querySelectorAll(".copy-link-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const url = `${location.origin}${location.pathname}#card-${btn.dataset.slug}`;
          // navigator.clipboard.writeText() peut rester bloquée indéfiniment
          // dans certains contextes (doc pas au premier plan, permission en
          // attente...) — on course contre un délai plutôt que d'attendre
          // indéfiniment sans retour pour l'utilisateur.
          const timeout = new Promise((_, reject) => setTimeout(() => reject(new Error("timeout")), 800));
          Promise.race([navigator.clipboard.writeText(url), timeout])
            .then(() => {
              const original = btn.textContent;
              btn.textContent = "✅";
              setTimeout(() => { btn.textContent = original; }, 1200);
            })
            .catch(() => {
              window.prompt("Copiez le lien :", url);
            });
        });
      });
    </script>

    <style is:global>
      body {
        background: #f4f3f0;
        color: #1a1a1a;
        font-family: system-ui, sans-serif;
        margin: 0;
      }
      main { max-width: 720px; margin: 0 auto; padding: 2rem 1rem 4rem; }
      h1 { font-size: 1.5rem; }
      .intro { color: #6b6a66; font-size: 0.9rem; margin-bottom: 1.5rem; }

      /* la barre de pills est sticky (~60px) : sans ça, sauter sur l'ancre
         d'une carte (#card-slug) la place pile sous la barre, cachée */
      .card { scroll-margin-top: 5rem; }

      .pillbar {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        gap: 0.5rem;
        padding: 0.75rem 0 1rem;
        margin: 0 0 0.5rem;
        background: #f4f3f0;
        overflow-x: auto;
      }
      .pill {
        flex: none;
        font: inherit;
        font-size: 0.82rem;
        padding: 0.4rem 0.9rem;
        border-radius: 999px;
        border: 1px solid #e3e2de;
        background: #ffffff;
        color: #6b6a66;
        cursor: pointer;
      }
      .pill:hover { border-color: #2454c7; color: #1a1a1a; }
      .pill.active { background: #1a1a1a; color: #ffffff; border-color: #1a1a1a; }
    </style>
  </body>
</html>
